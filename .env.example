# 复制成 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取同目录的 .env。

# ===== 面板登录（必填）=====
PANEL_USERNAME=admin
# 留空 compose 会直接报错拒绝启动 —— 管理面不允许裸奔。
PANEL_PASSWORD=改成你自己的强密码
# 建议填一串随机值（openssl rand -hex 32），重启后已登录的浏览器不用重新登录。
PANEL_SECRET=

# ===== 凭据主密钥 =====
# 32 字节的 base64（openssl rand -base64 32）。
# 不填则首次启动自动生成到 ./data/gateway/secrets/ 下，记得备份整个 data 目录。
GATEWAY_MASTER_KEY=

# ===== 端口 =====
# 8790 给客户端程序用；8791 是管理面板。
GATEWAY_PORT=8790
PANEL_PORT=8791

# 客户端该指向的对外地址（有域名/反代就写这里，面板会显示它）。
# 例：PUBLIC_BASE_URL=https://gw.example.com
PUBLIC_BASE_URL=

# 影响"今天"的判定与每日动作（签到 / 猫猫旅行 / 每日对话）。
TZ=Asia/Shanghai

# crates.io 镜像（仅构建时用）。官方源可留空。
CARGO_MIRROR=sparse+https://rsproxy.cn/index/
